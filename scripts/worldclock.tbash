
#!/usr/bin/env bash

# =====================================
#          TERMINATOR WORLD CLOCK
# =====================================

GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
RESET='\033[0m'

HIDE='\033[?25l'
SHOW='\033[?25h'

# Different Cities and their timezones
CITIES=(
    "Kolkata|Asia/Kolkata"
    "London|Europe/London"
    "New York|America/New_York"
    "Tokyo|Asia/Tokyo"
    "Dubai|Asia/Dubai"
    "Singapore|Asia/Singapore"
    "Sydney|Australia/Sydney"
    "Paris|Europe/Paris"
    "Los Angeles|America/Los_Angeles"
    "Moscow|Europe/Moscow"
    "Toronto|America/Toronto"
    "Chicago|America/Chicago"
    "San Francisco|America/Los_Angeles"
    "Berlin|Europe/Berlin"
    "Rome|Europe/Rome"
    "Madrid|Europe/Madrid"
    "Amsterdam|Europe/Amsterdam"
    "Zurich|Europe/Zurich"
    "Istanbul|Europe/Istanbul"
    "Bangkok|Asia/Bangkok"
    "Hong Kong|Asia/Hong_Kong"
    "Seoul|Asia/Seoul"
    "Beijing|Asia/Shanghai"
    "Jakarta|Asia/Jakarta"
    "Karachi|Asia/Karachi"
    "Dhaka|Asia/Dhaka"
    "Kathmandu|Asia/Kathmandu"
    "Cairo|Africa/Cairo"
    "Johannesburg|Africa/Johannesburg"
    "Nairobi|Africa/Nairobi"
    "Auckland|Pacific/Auckland"
    "Honolulu|Pacific/Honolulu"
)

cleanup() {
    printf '%b' "$RESET$SHOW"
    clear
    echo "World Clock closed."
    exit 0
}

trap cleanup INT TERM EXIT

printf '%b' "$HIDE"

while true; do
    clear

    echo -e "${CYAN}=============================================================="
    echo -e "                       WORLD CLOCK"
    echo -e "==============================================================${RESET}"

    echo
    printf "${YELLOW}%-20s %-25s %-15s${RESET}\n" \
        "CITY" "DATE" "TIME"

    echo "--------------------------------------------------------------"

    for CITY in "${CITIES[@]}"; do
        NAME="${CITY%%|*}"
        ZONE="${CITY##*|}"

        DATE=$(TZ="$ZONE" date '+%d-%m-%Y')
        TIME=$(TZ="$ZONE" date '+%H:%M:%S')

        if [[ "$NAME" == "Kolkata" ]]; then
            COLOR="$GREEN"
        else
            COLOR="$WHITE"
        fi

        printf "${COLOR}%-20s %-25s %-15s${RESET}\n" \
            "$NAME" "$DATE" "$TIME"
    done

    echo
    echo -e "${CYAN}==============================================================${RESET}"
    echo -e "${GREEN}32 cities | Updated every second${RESET}"
    echo -e "Press ${YELLOW}Ctrl+C${RESET} to exit."

    sleep 1
done
